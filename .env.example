# ================= Lark App (updatejenkinsbot) =================
# Subscription mode: Receive events through a persistent connection (long connection / WebSocket).
LARK_EVENT_MODE=websocket
APP_ID=cli_xxxxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 'lark' for Lark international (open.larksuite.com); 'feishu' for China Feishu.
LARK_DOMAIN=lark
PORT=5000

# Leave blank to auto-resolve from Lark at startup.
BOT_OPEN_ID=

# ================= Jenkins login =================
JENKINS_USERNAME=your-jenkins-user
JENKINS_PASSWORD=your-jenkins-password

# ================= VPN creation =================
createvpnid=your-vpn-user
createvpnpass=your-vpn-password

# ================= Playwright / warm browser pool =================
JENKINSUPDATE_BOT_HEADLESS=1
JU_WARM_POOL=1
JU_WARM_ALLOW_COLD_FALLBACK=0
JU_WARM_PREWARM_ON_STARTUP=1
JENKINS_WARM_STARTUP_WAIT_SEC=120
JENKINS_WARM_STARTUP_BLOCK=1
VPN_WARM_BROWSER=1
VPN_WARM_PREWARM_ON_STARTUP=1
VPN_WARM_ALLOW_COLD_FALLBACK=0

# --- How many browsers stay warm -----------------------------------------------------------------
# One warm browser costs ~6 chrome-headless-shell processes + a Node driver, ~385 MB. The pool knows
# 29 Jenkins job URLs; warming all of them is ~30 browsers / ~180 processes / ~11 GB. Only the jobs
# below stay warm — every other job launches on first use (~20s; /update runs say so in chat,
# internal parameter-discovery calls do not) and is released
# again once idle. Empty = the 5-job default baked into jenkinsupdate.py (_JU_WARM_HOT_DEFAULT).
# Tokens are matched case-folded as substrings of the canonical job-folder path.
JU_WARM_HOT_URLS=
# Idle seconds before a non-hot browser is released. 0 = never (the old behaviour).
JU_WARM_IDLE_TTL_SEC=1800
# Keepalive / idle-sweep cadence. Each tick re-navigates + re-logins every LIVE browser, so this is
# synthetic load on Jenkins — 240s across 30 browsers was ~7.5 page loads/min, forever.
JU_WARM_KEEPALIVE_SEC=600
# Revert to warming everything, no code change:
#   JU_WARM_HOT_URLS=*  +  JU_WARM_IDLE_TTL_SEC=0  +  JU_WARM_KEEPALIVE_SEC=240
#
# Extra Chromium switches (opt-in), applied to the /update pool browsers only — not the VPN one.
# The value below is disk-only and caps growth of those profiles under the temp dir, which
# nothing prunes. --disable-gpu saves another process per
# browser but A/B a real job's form screenshot first. NEVER pass --single-process, or any
# --disable-features= / --enable-features= / --blink-settings= — see _chrome_lean_args in
# jenkinsupdate.py for why (Playwright's own values are last-wins and would be silently dropped).
# JU_WARM_CHROME_ARGS=--disk-cache-size=33554432 --media-cache-size=1048576
#
# --- Warm-pool keys that exist only in code (defaults shown) --------------------------------------
# JU_WARM_URLS=            override the *known* job URL list (comma-separated); dev PCs only.
# JU_WARM_RETRY_ATTEMPTS=3 warm attempts before cold fallback / hard error.
# JU_WARM_RETRY_WAIT_SEC=90
# JU_WARM_BASE_URL=        login page used to warm a session (defaults to <jenkins>/login).
# VPN_WARM_KEEPALIVE_SEC=240
# VPN_WARM_RETRY_WAIT_SEC=90
# VPN_PLAYWRIGHT_USER_DATA_DIR=
# VPN_WARM_FORCE_OFF=      the ONLY way to drop the VPN browser. NOTE: VPN_WARM_BROWSER=0 does
#                          NOT work on Linux — _vpn_warm_enabled() force-returns True whenever the
#                          JU pool is on, and the systemd unit also sets VPN_WARM_BROWSER=1.

# ================= Self-deploy (git pull origin main + restart service) =================
UPDATEJENKINS_SERVICE=updatejenkins
# Comma-separated Lark open_ids allowed to trigger a deploy. Empty = anyone who can @mention.
DEPLOY_ALLOWED_OPEN_IDS=

# ================= Reply-to-update-email (/replyupdateemail) =================
# After a Jenkins build SUCCESS, reply-all in the ORIGINAL update-request email thread
# (mirrored from osedutybot: maintenance.py + maintenance_mail.py). Uses an IMAP+SMTP mailbox
# (Lark Mail by default). MAINTENANCE_MAIL_PASSWORD is REQUIRED for the reply to actually send;
# the rest fall back to the defaults shown below.
MAINTENANCE_MAIL_USER=om@hotelstotsenberg.com
MAINTENANCE_MAIL_PASSWORD=
MAINTENANCE_MAIL_IMAP_HOST=imap.larksuite.com
MAINTENANCE_MAIL_IMAP_PORT=993
MAINTENANCE_MAIL_SMTP_HOST=smtp.larksuite.com
MAINTENANCE_MAIL_SMTP_PORT=465
# Comma-separated Lark mail folders searched (in order) for the original thread.
JENKINS_REPLY_IMAP_FOLDERS=OSE Pending,INBOX,Sent,CLOSED EMAILS
# 1 (default) = quote the original under the reply (Lark ``history-quote-wrapper``), so Lark Mail
# shows the collapsible **Show/Hide email thread** exactly like a manual Reply All. The mail then
# goes out as a single text/html part. Set 0 for the old flat plain-text reply.
JENKINS_REPLY_QUOTE_THREAD=1
# Seconds allowed for re-reading the original by Message-ID just to build that quote (cache path
# only). Kept short on purpose — running out only costs the collapsible thread, never the reply.
JENKINS_REPLY_QUOTE_TIMEOUT=30

# ---- allemail.json: the 3-month rolling reply index -------------------------------------------
# Every value below is already the built-in default; set them only to override. Put ALLEMAIL_*
# keys HERE and never in a systemd `Environment=` line — they are read at import time, so a
# scanner started from cron/CLI would otherwise disagree with the bot about the window.
# 0 disables the index entirely (every reply then takes the slow live IMAP search).
ALLEMAIL_CACHE=1
# rolling = keep a trailing ALLEMAIL_WINDOW_DAYS window (default). weekly = hard-wipe every
# Monday 00:00 local and re-index from that Monday; ALLEMAIL_WINDOW_DAYS is then ignored.
ALLEMAIL_RESET_MODE=rolling
# ~3 calendar months. Defaults to JENKINS_REPLY_SINCE_DAYS so the index never covers less than
# the live search — a subject in the gap would be findable by neither.
ALLEMAIL_WINDOW_DAYS=92
# Days back the LIVE subject search looks (also the ALLEMAIL_WINDOW_DAYS default).
JENKINS_REPLY_SINCE_DAYS=92
# Newest-N UIDs indexed per folder. This binds BEFORE the window: set too low and the OLDEST part
# of the window is silently dropped (a warning is logged when it truncates).
ALLEMAIL_SCAN_CAP_PER_FOLDER=20000
# Hard cap on stored entries. ~92 days of a busy mailbox is ~10k entries / ~8 MB on disk.
ALLEMAIL_MAX_ENTRIES=30000
# Seconds between background scans. A 3-month scan is minutes of IMAP work, so keep it well
# above that; the scanner is best run out-of-process (systemd timer / cron).
ALLEMAIL_SCAN_INTERVAL_SEC=3600
# Retention is NOT reply-eligibility. A match newer than this always wins over an older one; an
# older match is used only when nothing fresh matches, and the Lark card flags it. Stops a "Done"
# notice landing on a months-old thread out of CLOSED EMAILS.
ALLEMAIL_REPLY_MAX_AGE_DAYS=14
# Lark open_id of the jenkinsbot sender whose /replyupdateemail is accepted without @mention.
JENKINS_BOT_OPEN_ID=
# Chat to post reply status into when a callback / internal POST omits chat_id (optional).
DUTY_CHAT_ID=
# Optional shared secret for POST /internal/reply-update-email (X-Duty-Internal-Token header).
DUTY_INTERNAL_TOKEN=

# ================= Natural-language parser (optional LLM) =================
BOT_CHAT_API_BASE=http://127.0.0.1:11434/v1
BOT_CHAT_API_KEY=ollama
BOT_CHAT_MODEL=qwen3.6:35b-a3b
# BOT_JENKINS_AGENT_DISABLE_LLM=1
